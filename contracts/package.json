{
  "name": "university-certificate-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx hardhat build",
    "test": "npx hardhat test",
    "test:solidity": "npx hardhat test solidity",
    "test:node": "npx hardhat test nodejs",
    "node": "npx hardhat node --hostname 127.0.0.1",
