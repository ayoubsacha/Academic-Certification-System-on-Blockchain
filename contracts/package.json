    "typecheck": "npx hardhat build && npx tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.10",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.5",
    "hardhat": "^3.22.0",
    "typescript": "~6.0.3",
    "viem": "^2.58.1"
  }
}
